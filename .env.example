# Copy to .env to override the defaults. Everything here has a working default
# for local development, so nothing is required to run `pnpm dev`.
#
# A deployment is the opposite: the server needs ALLOWED_ORIGINS and the client
# build needs VITE_SERVER_URL, because neither has a default that could be
# right. See "Deploying it" in the README.

# --- server ---

# Port the Colyseus server listens on. A hosting platform usually assigns this.
PORT=2567

# Comma-separated origins allowed to matchmake and open a socket. There is no
# wildcard: an origin not listed here is refused at the WebSocket upgrade.
# Defaults to the local Vite dev server. For a deployment this is the origin the
# client is served from, e.g. https://office.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The project board shows this GitHub repository's issues and open pull requests.
# owner/name, defaulting to this project's own repository.
PROJECT_BOARD_REPO=krasovsky22/agent-office-sims

# Optional GitHub token, read by the server only and never sent to a browser. A
# fine-grained token with read-only repository access is enough. Without one the
# board still works, polls less often (anonymous requests get 60 an hour), and
# shows no check status. Keep a real token out of this file: set it as a
# platform secret.
PROJECT_BOARD_TOKEN=

# Seconds between GitHub polls, at least 15. Defaults to 180 without a token and
# 60 with one.
PROJECT_BOARD_POLL_SECONDS=

# How agents do their issue work. `on` (the default) writes canned deliverables on a
# timer: no network call and no spend. `off` asks a language model and needs
# ANTHROPIC_API_KEY; the server refuses to start without one.
MOCK_AGENTS=on

# The model API key, read by the server only. Keep a real key out of this file:
# set it as a platform secret.
ANTHROPIC_API_KEY=

# The model agents use when MOCK_AGENTS is off. Defaults to claude-opus-5-5.
AGENT_MODEL=

# Ceilings on model calls, retries included: per UTC day, and for the life of
# the server process. Default 200 and 1000.
AGENT_CALLS_PER_DAY=
AGENT_CALLS_PER_RUN=

# How the AI manager answers the CEO. `on` (the default) answers from the
# office's live state by rule: no network call and no spend. `off` asks a
# language model and needs ANTHROPIC_API_KEY; the server refuses to start
# without one. Independent of MOCK_AGENTS.
MOCK_MANAGER=on

# The model the manager uses when MOCK_MANAGER is off. Defaults to claude-opus-5-5.
MANAGER_MODEL=

# The manager's own ceilings on model calls, one per message from the CEO,
# retries included: per UTC day, and for the life of the server process.
# Default 150 and 1000.
MANAGER_CALLS_PER_DAY=
MANAGER_CALLS_PER_RUN=

# Agent employees each room hires when it opens, from 0 to 8. Defaults to 4: a
# floor of them is read at a glance, and the board is what carries the scale.
AGENT_COUNT=

# `on` lets any connected client send an agent walking by typing
# `/goto <agent> <waypoint>` (or `<x> <z>`) into chat, which is how agent
# movement is exercised before anything decides where agents go. Off by
# default, and should stay off on a deployment: it is a command every visitor
# could send.
AGENT_DEBUG=

# Shared secret an agent orchestrator reports live coding agents with, as a
# bearer token on POST /agents/report, and collects the AI manager's
# assignments with, on POST /agents/assignments. At least 16 characters. Leave
# empty to switch both routes off. Keep a real one out of this file: set it as
# a platform secret.
LIVE_AGENTS_SECRET=

# Seconds without a report after which a live agent leaves the office, at least
# 5. Defaults to 60. A runner silent this long leaves with its slots.
LIVE_AGENTS_TIMEOUT_SECONDS=

# Shared secret an agent runner syncs its slots and collects its commands with,
# as a bearer token on POST /agents/runner/sync. At least 16 characters. Leave
# empty to switch the route off. Keep a real one out of this file: set it as a
# platform secret.
RUNNER_SECRET=

# --- client (build time) ---

# WebSocket URL the browser client connects to. Baked into the bundle by
# `pnpm build`, which refuses to build without it; it must be wss:// for any
# host other than localhost. Defaults to localhost under `pnpm dev` only.
VITE_SERVER_URL=ws://localhost:2567

# Set to `off` to skip the prop asset kit and render the grey-box office. A single
# tab can do the same with `?props=off`, without a rebuild.
VITE_PROPS=on

# --- runner (runtime, on the runner's own machine) ---
# Read by `pnpm dev:runner` / `pnpm --filter @sim/runner start`, never by the
# game server. RUNNER_SECRET above is the same value on both sides, and is the
# one setting the runner cannot start without.

# The game server's http(s) origin. Plain http only for this machine, since
# every sync carries the secret. Defaults to http://localhost:2567.
RUNNER_SERVER_URL=

# owner/name; the server refuses a runner on any other repository than its
# PROJECT_BOARD_REPO. Defaults to krasovsky22/agent-office-sims. The runner
# clones it with `gh repo clone`; for a private repository give the GitHub CLI
# read access (GH_TOKEN, or `gh auth login`) and run `gh auth setup-git`.
RUNNER_REPO=

# Absolute path for the runner's own files: its clone, its tasks' worktrees and
# which slot holds which. Defaults to ~/.sim-runner.
RUNNER_DATA_DIR=

# The agent each slot runs: `mock` (the default, and for now the only one).
RUNNER_AGENT=

# How a mock agent's work ends: `failed` (the default) or `pr-opened`, with a
# fake pull request.
RUNNER_MOCK_OUTCOME=

# Slots, from 1 to 4, the server's cap. Defaults to 2.
RUNNER_MAX_AGENTS=

# Whole minutes one task may run before its slot stops it. Defaults to 60.
RUNNER_TASK_TIMEOUT_MINUTES=
