# The build installs dependencies itself and copies only the server's half of
# the repository, so everything here is either rebuilt, unused, or must not
# leave the machine.

node_modules
**/node_modules
dist
**/dist
.git
.github
.vite
coverage
*.tsbuildinfo
*.log

# Local secrets and overrides. `.env.example` is committed and carries no
# values, but there is no reason for any of it to be in an image.
.env
.env.*

# A developer's local server data, such as the kept profile edits.
**/.data

.claude
.DS_Store
